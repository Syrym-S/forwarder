/* Generated by Vite. Firebase config is public; private keys never belong here. */
const firebaseConfigs = __FIREBASE_CONFIG__;
const firebaseConfig = new URL(self.registration.scope).pathname === "/staging/"
  ? firebaseConfigs.staging
  : firebaseConfigs.production;
const appUrl = new URL("forwarder/", self.registration.scope).href;
const allowedLinkOrigins = new Set([
  self.location.origin,
  "https://360logistics.kz",
  "https://forwarder.360logistics.kz",
]);

function safeUrl(value) {
  try {
    const url = new URL(value || appUrl, appUrl);
    const allowedProtocol = url.protocol === "https:" || url.origin === self.location.origin;
    return allowedProtocol && allowedLinkOrigins.has(url.origin) && !url.username && !url.password
      ? url.href
      : appUrl;
  } catch {
    return appUrl;
  }
}

// Register before Firebase's handler. Firebase handles clicks on its own notifications.
self.addEventListener("notificationclick", (event) => {
  const target = event.notification.data?.forwarderPushUrl;
  if (!target) return;
  event.stopImmediatePropagation();
  event.notification.close();
  event.waitUntil((async () => {
    const url = safeUrl(target);
    const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true });
    const existing = windows.find((client) => client.url === url);
    if (existing) return existing.focus();
    return self.clients.openWindow(url);
  })());
});

if (firebaseConfig.apiKey && firebaseConfig.projectId && firebaseConfig.messagingSenderId && firebaseConfig.appId) {
  importScripts("https://www.gstatic.com/firebasejs/__FIREBASE_SDK_VERSION__/firebase-app-compat.js");
  importScripts("https://www.gstatic.com/firebasejs/__FIREBASE_SDK_VERSION__/firebase-messaging-compat.js");
  firebase.initializeApp(firebaseConfig);
  firebase.messaging().onBackgroundMessage((payload) => {
    // The backend sends data-only messages. Retain the guard for Firebase Console tests,
    // where Firebase displays notification payloads automatically.
    if (payload.notification) return;
    const data = payload.data || {};
    if (!data.title && !data.body) return;
    return self.registration.showNotification(data.title || "360 Logistics", {
      body: data.body || "",
      tag: payload.messageId,
      data: { forwarderPushUrl: safeUrl(data.link), type: data.type || "" },
    });
  });
}
